// Whether a square index is on the board
inline BOOL IN_BOARD(int sq) {
  return ccInBoard[sq] != 0;
}

// Whether a square is inside a palace
inline BOOL IN_FORT(int sq) {
  return ccInFort[sq] != 0;
}

// Rank (y) of a square index
inline int RANK_Y(int sq) {
  return sq >> 4;
}

// File (x) of a square index
inline int FILE_X(int sq) {
  return sq & 15;
}

// Pack file/rank into square index
inline int COORD_XY(int x, int y) {
  return x + (y << 4);
}

// Flip square vertically (mirror rank)
inline int SQUARE_FLIP(int sq) {
  return 254 - sq;
}

// Mirror file coordinate
inline int FILE_FLIP(int x) {
  return 14 - x;
}

// Mirror rank coordinate
inline int RANK_FLIP(int y) {
  return 15 - y;
}

// Mirror square horizontally (file flip)
inline int MIRROR_SQUARE(int sq) {
  return COORD_XY(FILE_FLIP(FILE_X(sq)), RANK_Y(sq));
}

// One rank forward for side sd (red +1 rank, black -1 rank)
inline int SQUARE_FORWARD(int sq, int sd) {
  return sq - 16 + (sd << 5);
}

// King step span check
inline BOOL KING_SPAN(int sqSrc, int sqDst) {
  return ccLegalSpan[sqDst - sqSrc + 256] == 1;
}

// Advisor step span check
inline BOOL ADVISOR_SPAN(int sqSrc, int sqDst) {
  return ccLegalSpan[sqDst - sqSrc + 256] == 2;
}

// Bishop step span check
inline BOOL BISHOP_SPAN(int sqSrc, int sqDst) {
  return ccLegalSpan[sqDst - sqSrc + 256] == 3;
}

// Bishop blocking eye square
inline int BISHOP_PIN(int sqSrc, int sqDst) {
  return (sqSrc + sqDst) >> 1;
}

// Knight leg square
inline int KNIGHT_PIN(int sqSrc, int sqDst) {
  return sqSrc + ccKnightPin[sqDst - sqSrc + 256];
}

// Square on home side of river
inline BOOL HOME_HALF(int sq, int sd) {
  return (sq & 0x80) != (sd << 7);
}

// Square on away side of river
inline BOOL AWAY_HALF(int sq, int sd) {
  return (sq & 0x80) == (sd << 7);
}

// Both squares on same river half
inline BOOL SAME_HALF(int sqSrc, int sqDst) {
  return ((sqSrc ^ sqDst) & 0x80) == 0;
}

// Same rank
inline BOOL SAME_RANK(int sqSrc, int sqDst) {
  return ((sqSrc ^ sqDst) & 0xf0) == 0;
}

// Same file
inline BOOL SAME_FILE(int sqSrc, int sqDst) {
  return ((sqSrc ^ sqDst) & 0x0f) == 0;
}

// Side tag (red=8, black=16)
inline int SIDE_TAG(int sd) {
  return 8 + (sd << 3);
}

// Opponent side tag
inline int OPP_SIDE_TAG(int sd) {
  return 16 - (sd << 3);
}

// Move source square
inline int SRC(int mv) {
  return mv & 255;
}

// Move destination square
inline int DST(int mv) {
  return mv >> 8;
}

// Pack move from src/dst
inline int MOVE(int sqSrc, int sqDst) {
  return sqSrc + sqDst * 256;
}

// Mirror move horizontally
inline int MIRROR_MOVE(int mv) {
  return MOVE(MIRROR_SQUARE(SRC(mv)), MIRROR_SQUARE(DST(mv)));
}

// RC4 keystream generator (Zobrist init)
struct RC4Struct {
  BYTE s[256];
  int x, y;

  void InitZero(void);   // Initialize RC4 with empty key
  BYTE NextByte(void) {  // Next RC4 byte
    BYTE uc;
    x = (x + 1) & 255;
    y = (y + s[x]) & 255;
    uc = s[x];
    s[x] = s[y];
    s[y] = uc;
    return s[(s[x] + s[y]) & 255];
  }
  DWORD NextLong(void) { // Next four RC4 bytes as DWORD
    BYTE uc0, uc1, uc2, uc3;
    uc0 = NextByte();
    uc1 = NextByte();
    uc2 = NextByte();
    uc3 = NextByte();
    return uc0 + (uc1 << 8) + (uc2 << 16) + (uc3 << 24);
  }
};

// Initialize RC4 with empty key
void RC4Struct::InitZero(void) {
  int i, j;
  BYTE uc;

  x = y = j = 0;
  for (i = 0; i < 256; i ++) {
    s[i] = i;
  }
  for (i = 0; i < 256; i ++) {
    j = (j + s[i]) & 255;
    uc = s[i];
    s[i] = s[j];
    s[j] = uc;
  }
}

// Zobrist hash triple
struct ZobristStruct {
  DWORD dwKey, dwLock0, dwLock1;

  void InitZero(void) {                 // Zero Zobrist keys
    dwKey = dwLock0 = dwLock1 = 0;
  }
  void InitRC4(RC4Struct &rc4) {        // Fill Zobrist from RC4
    dwKey = rc4.NextLong();
    dwLock0 = rc4.NextLong();
    dwLock1 = rc4.NextLong();
  }
  void Xor(const ZobristStruct &zobr) { // XOR Zobrist keys
    dwKey ^= zobr.dwKey;
    dwLock0 ^= zobr.dwLock0;
    dwLock1 ^= zobr.dwLock1;
  }
  void Xor(const ZobristStruct &zobr1, const ZobristStruct &zobr2) {
    dwKey ^= zobr1.dwKey ^ zobr2.dwKey;
    dwLock0 ^= zobr1.dwLock0 ^ zobr2.dwLock0;
    dwLock1 ^= zobr1.dwLock1 ^ zobr2.dwLock1;
  }
};

// Global Zobrist tables
static struct {
  ZobristStruct Player;
  ZobristStruct Table[14][256];
} Zobrist;

// Initialize Zobrist tables
static void InitZobrist(void) {
  int i, j;
  RC4Struct rc4;

  rc4.InitZero();
  Zobrist.Player.InitRC4(rc4);
  for (i = 0; i < 14; i ++) {
    for (j = 0; j < 256; j ++) {
      Zobrist.Table[i][j].InitRC4(rc4);
    }
  }
}

// Move history entry (4 bytes)
struct MoveStruct {
  WORD wmv;
  BYTE ucpcCaptured, ucbCheck;
  DWORD dwKey;

  void Set(int mv, int pcCaptured, BOOL bCheck, DWORD dwKey_) {
    wmv = mv;
    ucpcCaptured = pcCaptured;
    ucbCheck = bCheck;
    dwKey = dwKey_;
  }
}; // mvs

// Position state
struct PositionStruct {
  int sdPlayer;                   // Side to move: 0=red, 1=black
  BYTE ucpcSquares[256];          // Board piece bytes
  int vlWhite, vlBlack;           // Material scores for red/black
  int nDistance, nMoveNum;        // Search ply and move-list length
  MoveStruct mvsList[MAX_MOVES];  // Move history stack
  ZobristStruct zobr;             // Zobrist
  xqwl_pst::Context pst;          // Blended PST for current irreversible position

  void ClearBoard(void) {         // Clear board and scores
    sdPlayer = vlWhite = vlBlack = nDistance = 0;
    memset(ucpcSquares, 0, 256);
    zobr.InitZero();
  }
  void SetIrrev(void) {           // Reset irreversible move list
    mvsList[0].Set(0, 0, Checked(), zobr.dwKey);
    nMoveNum = 1;
  }
  void Startup(void);             // Set standard start position
  void ChangeSide(void) {         // Switch side to move
    sdPlayer = 1 - sdPlayer;
    zobr.Xor(Zobrist.Player);
  }
  void AddPiece(int sq, int pc);  // Place piece and update hash/score
  void DelPiece(int sq, int pc);  // Remove piece and update hash/score
  int Evaluate(void) const {      // Static evaluation from side to move
    return (sdPlayer == 0 ? vlWhite - vlBlack : vlBlack - vlWhite) + pst.vlAdvanced;
  }
  void RefreshPst(void);          // Rebuild blended PST (call on real board changes / before search)
  BOOL InCheck(void) const {      // Was side to move in check after last move
    return mvsList[nMoveNum - 1].ucbCheck;
  }
  BOOL Captured(void) const {     // Was last move a capture
    return mvsList[nMoveNum - 1].ucpcCaptured != 0;
  }
  int MovePiece(int mv);                      // Apply move on board (no side change)
  void UndoMovePiece(int mv, int pcCaptured); // Undo board move
  BOOL MakeMove(int mv);                      // Make legal move (reject if leaves king in check)
  void UndoMakeMove(void);                    // Undo one ply (see below)
  void NullMove(void) {                       // Null move for pruning
    DWORD dwKey;
    dwKey = zobr.dwKey;
    ChangeSide();
    mvsList[nMoveNum].Set(0, 0, FALSE, dwKey);
    nMoveNum ++;
    nDistance ++;
  }
  void UndoNullMove(void) {                   // Undo null move
    nDistance --;
    nMoveNum --;
    ChangeSide();
  }
  // Generate pseudo-legal moves; captures only if bCapture
  int GenerateMoves(int *mvs, BOOL bCapture = FALSE) const;
  BOOL LegalMove(int mv) const;               // Pseudo-legal move geometry (no check test)
  BOOL Checked(void) const;                   // Is side to move in check now
  BOOL IsMate(void);                          // Is checkmate
  int DrawValue(void) const {                 // Draw score by ply parity
    return (nDistance & 1) == 0 ? -DRAW_VALUE : DRAW_VALUE;
  }
  int RepStatus(int nRecur = 1) const;        // Detect repetition along move list
  int RepValue(int nRepStatus) const {        // Score for repetition adjudication
    int vlReturn;
    vlReturn = ((nRepStatus & 2) == 0 ? 0 : nDistance - BAN_VALUE) +
        ((nRepStatus & 4) == 0 ? 0 : BAN_VALUE - nDistance);
    return vlReturn == 0 ? DrawValue() : vlReturn;
  }
  BOOL NullOkay(void) const {                 // Null-move pruning: PST material only (not NNUE)
    return (sdPlayer == 0 ? vlWhite : vlBlack) > NULL_OKAY_MARGIN;
  }
  BOOL NullSafe(void) const {                   // Skip null-move verification when material is high
    return (sdPlayer == 0 ? vlWhite : vlBlack) > NULL_SAFE_MARGIN;
  }
  /** Rook/knight/cannon/pawn count for side sd (ElephantEye null-move tiers). */
  int AttackingPieceCount(int sd) const {
    int count = 0;
    for (int sq = 0; sq < 256; ++sq) {
      if (!IN_BOARD(sq)) {
        continue;
      }
      const BYTE pc = ucpcSquares[sq];
      if (pc == 0) {
        continue;
      }
      const BOOL friendly = (pc < 16) ? (sd == 0) : (sd == 1);
      if (!friendly) {
        continue;
      }
      const int kind = (pc < 16) ? static_cast<int>(pc) - 8 : static_cast<int>(pc) - 16;
      if (kind >= PIECE_KNIGHT && kind <= PIECE_PAWN) {
        ++count;
      }
    }
    return count;
  }
  void Mirror(PositionStruct &posMirror) const; // Build horizontally mirrored copy
};

#include "xqwl_preeval.inc"

void PositionStruct::AddPiece(int sq, int pc) {
  ucpcSquares[sq] = pc;
  const int vl = xqwl_pst::pieceSquareValue(pst, pc, sq);
  if (pc < 16) {
    vlWhite += vl;
    zobr.Xor(Zobrist.Table[pc - 8][sq]);
  } else {
    vlBlack += vl;
    zobr.Xor(Zobrist.Table[pc - 9][sq]);
  }
}

void PositionStruct::DelPiece(int sq, int pc) {
  ucpcSquares[sq] = 0;
  const int vl = xqwl_pst::pieceSquareValue(pst, pc, sq);
  if (pc < 16) {
    vlWhite -= vl;
    zobr.Xor(Zobrist.Table[pc - 8][sq]);
  } else {
    vlBlack -= vl;
    zobr.Xor(Zobrist.Table[pc - 9][sq]);
  }
}

// Set standard start position
void PositionStruct::Startup(void) {
  int sq, pc;
  ClearBoard();
  for (sq = 0; sq < 256; sq ++) {
    pc = cucpcStartup[sq];
    if (pc != 0) {
      AddPiece(sq, pc);
    }
  }
  RefreshPst();
  SetIrrev();
}

// Rebuild blended PST and material totals for the current board.
// Not called from search-tree MakeMove/UndoMakeMove; invoke on real ply or at search root.
void PositionStruct::RefreshPst(void) {
  xqwl_pst::refresh(*this);
}

// Apply move on board (no side change)
int PositionStruct::MovePiece(int mv) {
  int sqSrc, sqDst, pc, pcCaptured;
  sqSrc = SRC(mv);
  sqDst = DST(mv);
  pcCaptured = ucpcSquares[sqDst];
  if (pcCaptured != 0) {
    DelPiece(sqDst, pcCaptured);
  }
  pc = ucpcSquares[sqSrc];
  DelPiece(sqSrc, pc);
  AddPiece(sqDst, pc);
  return pcCaptured;
}

// Undo board move
void PositionStruct::UndoMovePiece(int mv, int pcCaptured) {
  int sqSrc, sqDst, pc;
  sqSrc = SRC(mv);
  sqDst = DST(mv);
  pc = ucpcSquares[sqDst];
  DelPiece(sqDst, pc);
  AddPiece(sqSrc, pc);
  if (pcCaptured != 0) {
    AddPiece(sqDst, pcCaptured);
  }
}

// Make legal move (reject if leaves king in check)
BOOL PositionStruct::MakeMove(int mv) {
  if (nMoveNum >= MAX_MOVES) {
    return FALSE;
  }
  int pcCaptured;
  DWORD dwKey;

  dwKey = zobr.dwKey;
  pcCaptured = MovePiece(mv);
  if (Checked()) {
    UndoMovePiece(mv, pcCaptured);
    return FALSE;
  }
  ChangeSide();
  mvsList[nMoveNum].Set(mv, pcCaptured, Checked(), dwKey);
  nMoveNum ++;
  nDistance ++;
  return TRUE;
}

// Undo one ply (search/game tree; PST is not re-blended here)
void PositionStruct::UndoMakeMove(void) {
  nDistance --;
  nMoveNum --;
  ChangeSide();
  UndoMovePiece(mvsList[nMoveNum].wmv, mvsList[nMoveNum].ucpcCaptured);
}

// GenerateMoves flag
const BOOL GEN_CAPTURE = TRUE;

// Generate pseudo-legal moves; captures only if bCapture
int PositionStruct::GenerateMoves(int *mvs, BOOL bCapture) const {
  int i, j, nGenMoves, nDelta, sqSrc, sqDst;
  int pcSelfSide, pcOppSide, pcSrc, pcDst;
  // Move generation steps:

  nGenMoves = 0;
  const auto push_mv = [&](int mv) -> bool {
    if (nGenMoves >= MAX_GEN_MOVES) {
      return false;
    }
    mvs[nGenMoves++] = mv;
    return true;
  };
  pcSelfSide = SIDE_TAG(sdPlayer);
  pcOppSide = OPP_SIDE_TAG(sdPlayer);
  for (sqSrc = 0; sqSrc < 256; sqSrc ++) {

    // 1. Skip unless square holds own piece
    pcSrc = ucpcSquares[sqSrc];
    if ((pcSrc & pcSelfSide) == 0) {
      continue;
    }

    // 2. Emit moves by piece type
    switch (pcSrc - pcSelfSide) {
    case PIECE_KING:
      for (i = 0; i < 4; i ++) {
        sqDst = sqSrc + ccKingDelta[i];
        if (!IN_FORT(sqDst)) {
          continue;
        }
        pcDst = ucpcSquares[sqDst];
        if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
          push_mv(MOVE(sqSrc, sqDst));
        }
      }
      break;
    case PIECE_ADVISOR:
      for (i = 0; i < 4; i ++) {
        sqDst = sqSrc + ccAdvisorDelta[i];
        if (!IN_FORT(sqDst)) {
          continue;
        }
        pcDst = ucpcSquares[sqDst];
        if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
          push_mv(MOVE(sqSrc, sqDst));
        }
      }
      break;
    case PIECE_BISHOP:
      for (i = 0; i < 4; i ++) {
        sqDst = sqSrc + ccAdvisorDelta[i];
        if (!(IN_BOARD(sqDst) && HOME_HALF(sqDst, sdPlayer) && ucpcSquares[sqDst] == 0)) {
          continue;
        }
        sqDst += ccAdvisorDelta[i];
        pcDst = ucpcSquares[sqDst];
        if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
          push_mv(MOVE(sqSrc, sqDst));
        }
      }
      break;
    case PIECE_KNIGHT:
      for (i = 0; i < 4; i ++) {
        sqDst = sqSrc + ccKingDelta[i];
        if (ucpcSquares[sqDst] != 0) {
          continue;
        }
        for (j = 0; j < 2; j ++) {
          sqDst = sqSrc + ccKnightDelta[i][j];
          if (!IN_BOARD(sqDst)) {
            continue;
          }
          pcDst = ucpcSquares[sqDst];
          if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
            push_mv(MOVE(sqSrc, sqDst));
          }
        }
      }
      break;
    case PIECE_ROOK:
      for (i = 0; i < 4; i ++) {
        nDelta = ccKingDelta[i];
        sqDst = sqSrc + nDelta;
        while (IN_BOARD(sqDst)) {
          pcDst = ucpcSquares[sqDst];
          if (pcDst == 0) {
            if (!bCapture) {
              push_mv(MOVE(sqSrc, sqDst));
            }
          } else {
            if ((pcDst & pcOppSide) != 0) {
              push_mv(MOVE(sqSrc, sqDst));
            }
            break;
          }
          sqDst += nDelta;
        }
      }
      break;
    case PIECE_CANNON:
      for (i = 0; i < 4; i ++) {
        nDelta = ccKingDelta[i];
        sqDst = sqSrc + nDelta;
        while (IN_BOARD(sqDst)) {
          pcDst = ucpcSquares[sqDst];
          if (pcDst == 0) {
            if (!bCapture) {
              push_mv(MOVE(sqSrc, sqDst));
            }
          } else {
            break;
          }
          sqDst += nDelta;
        }
        sqDst += nDelta;
        while (IN_BOARD(sqDst)) {
          pcDst = ucpcSquares[sqDst];
          if (pcDst != 0) {
            if ((pcDst & pcOppSide) != 0) {
              push_mv(MOVE(sqSrc, sqDst));
            }
            break;
          }
          sqDst += nDelta;
        }
      }
      break;
    case PIECE_PAWN:
      sqDst = SQUARE_FORWARD(sqSrc, sdPlayer);
      if (IN_BOARD(sqDst)) {
        pcDst = ucpcSquares[sqDst];
        if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
          push_mv(MOVE(sqSrc, sqDst));
        }
      }
      if (AWAY_HALF(sqSrc, sdPlayer)) {
        for (nDelta = -1; nDelta <= 1; nDelta += 2) {
          sqDst = sqSrc + nDelta;
          if (IN_BOARD(sqDst)) {
            pcDst = ucpcSquares[sqDst];
            if (bCapture ? (pcDst & pcOppSide) != 0 : (pcDst & pcSelfSide) == 0) {
              push_mv(MOVE(sqSrc, sqDst));
            }
          }
        }
      }
      break;
    }
  }
  return nGenMoves;
}

// Pseudo-legal move geometry (no check test)
BOOL PositionStruct::LegalMove(int mv) const {
  int sqSrc, sqDst, sqPin;
  int pcSelfSide, pcSrc, pcDst, nDelta;
  // LegalMove checks:

  // 1. Source square must hold own piece
  sqSrc = SRC(mv);
  pcSrc = ucpcSquares[sqSrc];
  pcSelfSide = SIDE_TAG(sdPlayer);
  if ((pcSrc & pcSelfSide) == 0) {
    return FALSE;
  }

  // 2. Destination must not hold own piece
  sqDst = DST(mv);
  pcDst = ucpcSquares[sqDst];
  if ((pcDst & pcSelfSide) != 0) {
    return FALSE;
  }

  // 3. Piece-specific geometry
  switch (pcSrc - pcSelfSide) {
  case PIECE_KING:
    return IN_FORT(sqDst) && KING_SPAN(sqSrc, sqDst);
  case PIECE_ADVISOR:
    return IN_FORT(sqDst) && ADVISOR_SPAN(sqSrc, sqDst);
  case PIECE_BISHOP:
    return SAME_HALF(sqSrc, sqDst) && BISHOP_SPAN(sqSrc, sqDst) &&
        ucpcSquares[BISHOP_PIN(sqSrc, sqDst)] == 0;
  case PIECE_KNIGHT:
    sqPin = KNIGHT_PIN(sqSrc, sqDst);
    return sqPin != sqSrc && ucpcSquares[sqPin] == 0;
  case PIECE_ROOK:
  case PIECE_CANNON:
    if (SAME_RANK(sqSrc, sqDst)) {
      nDelta = (sqDst < sqSrc ? -1 : 1);
    } else if (SAME_FILE(sqSrc, sqDst)) {
      nDelta = (sqDst < sqSrc ? -16 : 16);
    } else {
      return FALSE;
    }
    sqPin = sqSrc + nDelta;
    while (sqPin != sqDst && ucpcSquares[sqPin] == 0) {
      sqPin += nDelta;
    }
    if (sqPin == sqDst) {
      return pcDst == 0 || pcSrc - pcSelfSide == PIECE_ROOK;
    } else if (pcDst != 0 && pcSrc - pcSelfSide == PIECE_CANNON) {
      sqPin += nDelta;
      while (sqPin != sqDst && ucpcSquares[sqPin] == 0) {
        sqPin += nDelta;
      }
      return sqPin == sqDst;
    } else {
      return FALSE;
    }
  case PIECE_PAWN:
    if (AWAY_HALF(sqDst, sdPlayer) && (sqDst == sqSrc - 1 || sqDst == sqSrc + 1)) {
      return TRUE;
    }
    return sqDst == SQUARE_FORWARD(sqSrc, sdPlayer);
  default:
    return FALSE;
  }
}

// Is side to move in check now
BOOL PositionStruct::Checked() const {
  int i, j, sqSrc, sqDst;
  int pcSelfSide, pcOppSide, pcDst, nDelta;
  pcSelfSide = SIDE_TAG(sdPlayer);
  pcOppSide = OPP_SIDE_TAG(sdPlayer);
  // Locate own king, then:

  for (sqSrc = 0; sqSrc < 256; sqSrc ++) {
    if (ucpcSquares[sqSrc] != pcSelfSide + PIECE_KING) {
      continue;
    }

    // 1. Pawn checks
    if (ucpcSquares[SQUARE_FORWARD(sqSrc, sdPlayer)] == pcOppSide + PIECE_PAWN) {
      return TRUE;
    }
    for (nDelta = -1; nDelta <= 1; nDelta += 2) {
      if (ucpcSquares[sqSrc + nDelta] == pcOppSide + PIECE_PAWN) {
        return TRUE;
      }
    }

    // 2. Knight checks (advisor delta as leg)
    for (i = 0; i < 4; i ++) {
      if (ucpcSquares[sqSrc + ccAdvisorDelta[i]] != 0) {
        continue;
      }
      for (j = 0; j < 2; j ++) {
        pcDst = ucpcSquares[sqSrc + ccKnightCheckDelta[i][j]];
        if (pcDst == pcOppSide + PIECE_KNIGHT) {
          return TRUE;
        }
      }
    }

    // 3. Rook/cannon/king-face checks
    for (i = 0; i < 4; i ++) {
      nDelta = ccKingDelta[i];
      sqDst = sqSrc + nDelta;
      while (IN_BOARD(sqDst)) {
        pcDst = ucpcSquares[sqDst];
        if (pcDst != 0) {
          if (pcDst == pcOppSide + PIECE_ROOK || pcDst == pcOppSide + PIECE_KING) {
            return TRUE;
          }
          break;
        }
        sqDst += nDelta;
      }
      sqDst += nDelta;
      while (IN_BOARD(sqDst)) {
        int pcDst = ucpcSquares[sqDst];
        if (pcDst != 0) {
          if (pcDst == pcOppSide + PIECE_CANNON) {
            return TRUE;
          }
          break;
        }
        sqDst += nDelta;
      }
    }
    return FALSE;
  }
  return FALSE;
}

// Is checkmate
BOOL PositionStruct::IsMate(void) {
  int i, nGenMoveNum, pcCaptured;
  int mvs[MAX_GEN_MOVES];

  nGenMoveNum = GenerateMoves(mvs);
  for (i = 0; i < nGenMoveNum; i ++) {
    pcCaptured = MovePiece(mvs[i]);
    if (!Checked()) {
      UndoMovePiece(mvs[i], pcCaptured);
      return FALSE;
    } else {
      UndoMovePiece(mvs[i], pcCaptured);
    }
  }
  return TRUE;
}

// Detect repetition along move list
int PositionStruct::RepStatus(int nRecur) const {
  BOOL bSelfSide, bPerpCheck, bOppPerpCheck;
  const MoveStruct *lpmvs;

  bSelfSide = FALSE;
  bPerpCheck = bOppPerpCheck = TRUE;
  lpmvs = mvsList + nMoveNum - 1;
  while (lpmvs->wmv != 0 && lpmvs->ucpcCaptured == 0) {
    if (bSelfSide) {
      bPerpCheck = bPerpCheck && lpmvs->ucbCheck;
      if (lpmvs->dwKey == zobr.dwKey) {
        nRecur --;
        if (nRecur == 0) {
          return 1 + (bPerpCheck ? 2 : 0) + (bOppPerpCheck ? 4 : 0);
        }
      }
    } else {
      bOppPerpCheck = bOppPerpCheck && lpmvs->ucbCheck;
    }
    bSelfSide = !bSelfSide;
    lpmvs --;
  }
  return 0;
}

// Build horizontally mirrored copy
void PositionStruct::Mirror(PositionStruct &posMirror) const {
  int sq, pc;
  posMirror.ClearBoard();
  for (sq = 0; sq < 256; sq ++) {
    pc = ucpcSquares[sq];
    if (pc != 0) {
      posMirror.AddPiece(MIRROR_SQUARE(sq), pc);
    }
  }
  if (sdPlayer == 1) {
    posMirror.ChangeSide();
  }
  posMirror.RefreshPst();
  posMirror.SetIrrev();
}
